# ==========================================
# AI SDR & SALES AUTOMATION PLATFORM ENV VARS
# ==========================================

# Mode: true runs simulated local adapters (zero cost, no API keys needed)
DEMO_MODE=true

# Supabase (PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Providers (Groq is primary)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Automation Engine (n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ai-sdr-event

# Outbound Email (Resend or SMTP)
EMAIL_PROVIDER=demo
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Arjun Mehta <arjun@sales.apexindus.in>"

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_PROVIDER=demo
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Voice / Telephony (Exotel / Twilio / Local Whisper + Piper)
VOICE_PROVIDER=demo
VOICE_API_KEY=
VOICE_ACCOUNT_SID=

# Calendar Booking (Google Calendar / Calendly)
CALENDAR_PROVIDER=demo
CALENDLY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
