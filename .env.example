# ==========================================
# AI SDR & SALES AUTOMATION PLATFORM ENV VARS
# ==========================================

# Mode: true runs simulated local adapters (zero cost, no API keys needed)
DEMO_MODE=true

# Supabase (PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Providers (Groq is primary)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Automation Engine (n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ai-sdr-event

# Outbound Email (Resend or SMTP)
EMAIL_PROVIDER=demo
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Arjun Mehta <arjun@sales.apexindus.in>"

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_PROVIDER=demo
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Voice module — provider selection: demo (default) or dograh
VOICE_PROVIDER=demo
VOICE_API_KEY=
VOICE_ACCOUNT_SID=

# Dograh (WebRTC "Talk to our AI" + optional PSTN via Vobiz) — see docs/voice/DOGRAH_CONTRACTS.md
DOGRAH_API_KEY=
DOGRAH_BASE_URL=https://api.dograh.com
DOGRAH_TRIGGER_UUID=
DOGRAH_WEBHOOK_SECRET=demo_webhook_secret
DOGRAH_TOOL_SECRET=demo_tool_secret
DOGRAH_TELEPHONY_CONFIG_ID=
DOGRAH_FROM_PHONE_ID=

# n8n voice workflows (n8n/workflows/*.json) — post-call follow-up hand-off from the app
N8N_POST_CALL_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Calendar Booking (Google Calendar / Calendly)
CALENDAR_PROVIDER=demo
CALENDLY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# FREE STACK — persistence, delivery safety, browser voice
# ==========================================
# Where the server keeps its JSON snapshot (default: ./.data/apex-store.json). APEX_PERSIST=false disables it.
APEX_DATA_DIR=
APEX_PERSIST=true

# Public URL used inside talk links and calendar invites
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Delivery safety: when either is set, the initial delivery mode is LIVE_REDIRECT — every real email/WhatsApp
# goes to these test destinations instead of the prospect (change any time in Settings → Delivery).
OUTBOUND_TEST_EMAIL=
OUTBOUND_TEST_PHONE=

# Groq free tier (openai/gpt-oss-120b default; whisper-large-v3-turbo for voice transcription)
GROQ_MODEL=openai/gpt-oss-120b

# Browser voice agent TTS: browser (default, free) or groq (Orpheus English voices, free tier)
VOICE_TTS_PROVIDER=browser
GROQ_TTS_VOICE=tara
